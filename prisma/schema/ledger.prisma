model IndexedLedger {
  id        Int      @id @default(1)
  ledger    Int
  cursor    String
  updatedAt DateTime @updatedAt

  @@map("indexed_ledgers")
}

model LedgerCheckpoint {
  id                    Int      @id @default(autoincrement())
  ledger                Int
  lastProcessedEventIndex Int
  batchHash             String
  completedAt           DateTime @default(now())

  @@unique([ledger])
  @@index([ledger])
  @@map("ledger_checkpoints")
}
