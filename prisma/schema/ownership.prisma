// prisma/schema/ownership.prisma

model KeyOwnership {
  id            String   @id @default(cuid())
  
  // The wallet address of the owner
  ownerAddress  String
  
  // The ID or handle of the creator whose keys are owned
  creatorId     String
  
   // The amount of keys owned
   balance       Decimal  @default(0)
   costBasis     Decimal? @default(0)

   /// Lifetime realised P&L in XLM, persisted at sell execution time (#897).
   realisedPnl   Decimal? @default(0)

   /// Timestamp of the owner's most recent buy of this key, if any.
   lastBuyAt     DateTime?

   /// When the current lockup window ends for this holding, if any.
   lockupExpiresAt DateTime?

   /// Self-custody freeze flag: frozen positions cannot trade or transfer (#885).
   frozen         Boolean   @default(false)
   /// When the holder froze this position, if currently frozen (#885).
   frozenAt       DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerAddress, creatorId])
  @@index([ownerAddress])
  @@index([creatorId])
}
model Invoice {
  id            String   @id @default(cuid())
  invoiceId     String   @unique // External invoice identifier (e.g., tx hash or custom ID)
  creatorId     String
  amount        Decimal  // Number of keys purchased
  rate          Decimal  // Price per key at time of purchase
  maturity      DateTime // When the invoice/matured
  riskRating    String   // Risk rating (e.g., "low", "medium", "high")
  sellerStats   Json     // Additional seller statistics
  fundingProgress Decimal // Funding progress percentage or amount
  tradeType     String   // "buy" or "sell"
  actor         String   // Wallet address of the buyer/seller
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([creatorId])
  @@index([invoiceId])
}
/// Payment record for a holder buyback on a deprecated key (#882).
/// Written in the same transaction that zeroes the holder balance so the
/// balance reduction and the payment are atomic.
model KeyBuyback {
  id              String   @id @default(cuid())
  keyId           String
  holderAddress   String
  quantity        Decimal
  pricePerKeyXlm  Decimal  @db.Decimal(20, 7)
  amountXlm       Decimal  @db.Decimal(20, 7)
  txHash          String?
  processedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([keyId])
  @@index([holderAddress])
  @@index([processedAt(sort: Desc)])
}
