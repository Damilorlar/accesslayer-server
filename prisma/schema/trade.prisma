// prisma/schema/trade.prisma

model Trade {
  id         String   @id @default(cuid())
  buyer      String
  creatorId  String
  quantity   String
  price      String
  ledger     Int
  txHash     String
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@unique([ledger, txHash])
  @@index([creatorId])
  @@index([buyer])
  @@index([ledger])
}
